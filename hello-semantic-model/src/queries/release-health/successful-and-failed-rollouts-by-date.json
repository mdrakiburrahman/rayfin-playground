{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "calculate": "timeFormat(toDate(datum.Date), '%b %d')",
      "as": "DateLabel"
    },
    {
      "fold": [
        "SuccessfulRollouts",
        "FailedRollouts"
      ],
      "as": [
        "OutcomeKey",
        "Rollouts"
      ]
    },
    {
      "calculate": "datum.OutcomeKey === 'SuccessfulRollouts' ? 'Successful rollouts' : 'Failed rollouts'",
      "as": "Outcome"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "DateLabel",
      "type": "ordinal",
      "title": null,
      "sort": null,
      "axis": {
        "labelAngle": -45,
        "labelOverlap": "greedy"
      }
    },
    "xOffset": {
      "field": "Outcome"
    },
    "y": {
      "field": "Rollouts",
      "type": "quantitative",
      "title": "Rollouts"
    },
    "color": {
      "field": "Outcome",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Successful rollouts",
          "Failed rollouts"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "Outcome",
        "type": "nominal",
        "title": "Outcome"
      },
      {
        "field": "Rollouts",
        "type": "quantitative",
        "title": "Rollouts"
      }
    ]
  }
}
