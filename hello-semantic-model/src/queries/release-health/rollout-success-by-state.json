{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "calculate": "datum.IsSuccess ? 'Successful' : 'Not successful'",
      "as": "Outcome"
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %d",
        "labelOverlap": "greedy"
      }
    },
    "y": {
      "field": "DailyRolloutCount",
      "type": "quantitative",
      "title": "Daily rollout count"
    },
    "color": {
      "field": "Outcome",
      "type": "nominal",
      "title": "Success",
      "scale": {
        "domain": [
          "Successful",
          "Not successful"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "Outcome",
        "type": "nominal",
        "title": "Success"
      },
      {
        "field": "DailyRolloutCount",
        "type": "quantitative",
        "title": "Daily rollout count"
      }
    ]
  }
}
