{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "mark": {
    "type": "line",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %d",
        "labelOverlap": "greedy"
      }
    },
    "y": {
      "field": "SuccessfulRollouts",
      "type": "quantitative",
      "title": "Successful rollouts"
    },
    "color": {
      "field": "Environment",
      "type": "nominal",
      "title": "Environment",
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "Environment",
        "type": "nominal",
        "title": "Environment"
      },
      {
        "field": "SuccessfulRollouts",
        "type": "quantitative",
        "title": "Successful rollouts"
      }
    ]
  }
}
