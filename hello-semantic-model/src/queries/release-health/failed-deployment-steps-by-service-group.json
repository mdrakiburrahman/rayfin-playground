{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "mark": {
    "type": "line",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %d",
        "labelOverlap": "greedy"
      }
    },
    "y": {
      "field": "StepFailures",
      "type": "quantitative",
      "title": "Step failures"
    },
    "color": {
      "field": "ServiceGroup",
      "type": "nominal",
      "title": "Service group",
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "columns": 1
      }
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "ServiceGroup",
        "type": "nominal",
        "title": "Service group"
      },
      {
        "field": "StepFailures",
        "type": "quantitative",
        "title": "Step failures"
      }
    ]
  }
}
