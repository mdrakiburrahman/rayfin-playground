{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "calculate": "timeFormat(toDate(datum.Date), '%b %d')",
      "as": "DateLabel"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "DateLabel",
      "type": "ordinal",
      "title": null,
      "sort": null,
      "axis": {
        "labelAngle": -45,
        "labelOverlap": "greedy"
      }
    },
    "y": {
      "field": "RolloutAttempts",
      "type": "quantitative",
      "title": "Rollout attempts"
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "RolloutAttempts",
        "type": "quantitative",
        "title": "Rollout attempts"
      }
    ]
  }
}
