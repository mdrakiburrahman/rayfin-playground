{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "fold": [
        "SuccessfulRollouts",
        "FailedRollouts"
      ],
      "as": [
        "OutcomeKey",
        "Rollouts"
      ]
    },
    {
      "calculate": "datum.OutcomeKey === 'SuccessfulRollouts' ? 'Successful' : 'Failed'",
      "as": "Outcome"
    }
  ],
  "mark": {
    "type": "line",
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "Date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %d",
        "labelOverlap": "greedy"
      }
    },
    "y": {
      "field": "Rollouts",
      "type": "quantitative",
      "title": "Rollouts"
    },
    "color": {
      "field": "Outcome",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Successful",
          "Failed"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "Outcome",
        "type": "nominal",
        "title": "Outcome"
      },
      {
        "field": "Rollouts",
        "type": "quantitative",
        "title": "Rollouts"
      },
      {
        "field": "RolloutSuccessRate",
        "type": "quantitative",
        "title": "Success rate"
      }
    ]
  }
}
