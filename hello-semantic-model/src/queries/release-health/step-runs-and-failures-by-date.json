{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "calculate": "timeFormat(toDate(datum.Date), '%b %d')",
      "as": "DateLabel"
    },
    {
      "fold": [
        "StepRuns",
        "StepFailures"
      ],
      "as": [
        "MetricKey",
        "Count"
      ]
    },
    {
      "calculate": "datum.MetricKey === 'StepRuns' ? 'Step runs' : 'Step failures'",
      "as": "Metric"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "DateLabel",
      "type": "ordinal",
      "title": null,
      "sort": null,
      "axis": {
        "labelAngle": -45,
        "labelOverlap": "greedy"
      }
    },
    "xOffset": {
      "field": "Metric"
    },
    "y": {
      "field": "Count",
      "type": "quantitative",
      "title": "Step count"
    },
    "color": {
      "field": "Metric",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Step runs",
          "Step failures"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "Date",
        "type": "temporal",
        "title": "Date"
      },
      {
        "field": "Metric",
        "type": "nominal",
        "title": "Metric"
      },
      {
        "field": "Count",
        "type": "quantitative",
        "title": "Count"
      }
    ]
  }
}
